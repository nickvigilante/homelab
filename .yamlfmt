# yamlfmt config — deliberately conservative so it normalizes whitespace
# without fighting the repo's hand-styled k8s manifests / Helm values.
# Verified to preserve Authentik blueprint custom tags (!Env/!Find/!KeyOf)
# and the backup CronJob's embedded shell heredoc byte-for-byte.
formatter:
  type: basic
  retain_line_breaks_single: true   # keep single blank lines (readability)
  indent: 2
  include_document_start: false
  pad_line_comments: 1
