{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "automerge": false,
  "ignorePaths": ["clusters/gandalf/flux-system/**"],
  "flux": {
    "managerFilePatterns": ["/^(k8s|clusters|sources)/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  }
}
